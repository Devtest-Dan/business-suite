# Local development: copy to .env.local. On a server, deploy/install.sh writes
# /opt/business-suite/.env (with generated secrets) instead.

# PostgreSQL 16. For development:
#   docker run -d --name suite-pg-dev -e POSTGRES_USER=suite -e POSTGRES_PASSWORD=suite -p 5481:5432 postgres:16-alpine
DATABASE_URL=postgres://suite:suite@localhost:5481/suite

# 32 random bytes, base64: encrypts stored API keys and the SMTP password.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SUITE_SECRET_KEY=

# The address people open (invite and reset links use it).
SUITE_URL=http://localhost:3081

# When set, the first-run setup page asks for this code.
SUITE_SETUP_CODE=

# Uploaded files (default ./data/files). Or keep them in any S3-compatible bucket:
SUITE_FILES_DIR=./data/files
FILES_S3_ENDPOINT=
FILES_S3_REGION=
FILES_S3_BUCKET=
FILES_S3_ACCESS_KEY_ID=
FILES_S3_SECRET_ACCESS_KEY=

# The Assistant app's optional business brain (GBrain). Empty = off: facts stay in
# the suite's database. For development, run deploy/brain/ (docs/apps/assistant.md):
#   docker build -t business-suite-brain:dev deploy/brain
#   docker run -d --name suite-brain --memory 1g -e GBRAIN_ADMIN_BOOTSTRAP_TOKEN=<same as below> \
#     -e BRAIN_PUBLIC_URL=http://127.0.0.1:7410 -p 127.0.0.1:7410:7410 -v suite-brain:/data business-suite-brain:dev
BRAIN_URL=
# The --public-url the brain started with (default: BRAIN_URL). Compose sets http://127.0.0.1:7410.
BRAIN_PUBLIC_URL=
# Any long random string (openssl rand -hex 32); the brain must start with the same one.
BRAIN_ADMIN_TOKEN=

# Tests: the Postgres server the unit and e2e tests create their databases on,
# and (optional) the name of the unit-test database (default suite_test).
SUITE_TEST_ADMIN_URL=postgres://suite:suite@localhost:5481/suite
# The database the unit tests create (dropped and remade each run). Give each parallel checkout its own.
SUITE_TEST_DATABASE=suite_test
